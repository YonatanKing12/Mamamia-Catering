# ═══════════════════════════════════════════════════════════════
#  מאמא מיה קייטרינג — משתני סביבה
#  העתיקו את הקובץ ל־.env ומלאו. אף אחד מהם אינו חובה לפיתוח מקומי.
#  .env נמצא ב־.gitignore ולא נדחף לגיט. אל תשנו את זה.
# ═══════════════════════════════════════════════════════════════

# ── פורט ──
# 3000 כברירת מחדל. לא 5000: הפורט הזה תפוס ב־macOS על ידי AirPlay.
PORT=3000

# ── מסד נתונים (אופציונלי בפיתוח) ──
# בלי הערך הזה השרת עולה ושומר לידים בזיכרון — נוח לפיתוח, נדיף לחלוטין.
# בפרודקשן זה חובה, אחרת לידים נמחקים בכל restart.
# עובד מול כל Postgres: Neon, Supabase, Railway, RDS, או מקומי.
#   Neon/Supabase:  postgresql://user:pass@host/db?sslmode=require
#   מקומי:          postgresql://postgres:postgres@localhost:5432/mamamia?sslmode=disable
DATABASE_URL=

# ── תעודת CA של ספק המסד ──
# החיבור מאמת את השרת במלואו (rejectUnauthorized: true) ולא רק מצפין,
# כי הוא נושא את השם והטלפון של כל ליד. ספק שמשתמש ב־CA פרטי —
# Supabase, RDS — דורש את התעודה כאן. Neon עובד בלי זה.
DATABASE_CA_CERT=

# ── טוקן אדמין לצפייה בלידים ──
# מגן על GET /api/leads. בלי טוקן באורך 24 תווים ומעלה הנתיב מושבת לגמרי
# ומחזיר 503 — כך שאי אפשר להשאיר את הלידים פתוחים בטעות.
# ליצירת טוקן:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ── התראה על ליד חדש ──
# כל ליד נשלח כ־POST JSON לכתובת הזאת מיד עם קליטתו.
# מתחבר ל־Zapier / Make / n8n / ספק WhatsApp API — משם למייל או לוואטסאפ.
# בלי זה לידים נשמרים אבל אף אחד לא מקבל התראה. אל תעלו לאוויר בלי זה.
NOTIFY_WEBHOOK_URL=

# ── חסימת אינדוקס לתצוגה מקדימה ──
# SITE_NOINDEX=1 גורם ל־robots.txt לחסום את כל האתר לכל הזחלנים.
# הכרחי בפריסה ראשונה: אינדוקס של גרסה בלי מנות, בלי מחירים ובלי נוסח
# כשרות מדויק יוצר תוצאות שנשארות בגוגל חודשים אחרי שהתוכן הושלם.
# להסיר את המשתנה ביום שהתוכן שלם — ולא לפני.
SITE_NOINDEX=1
